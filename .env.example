# =======================================================
# NAREE VENDTRACK — ROOT .env.example
# Copy this to .env and fill in your values.
# NEVER commit the actual .env file.
# =======================================================

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/naree_vending?schema=public"

# Authentication
JWT_SECRET="change_this_to_a_long_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# -------------------------------------------------------
# MOCK MODE
# Set to "true" for local development without real services.
# Set to "false" (or remove) for production.
# -------------------------------------------------------
MOCK_MODE=true

# Payment Operational Mode ('mock' | 'production')
PAYMENT_PROVIDER_MODE=mock

# PhonePe Merchant Gateway
PHONEPE_MERCHANT_ID="YOUR_PHONEPE_MERCHANT_ID"
PHONEPE_CLIENT_ID="YOUR_PHONEPE_CLIENT_ID"
PHONEPE_CLIENT_SECRET="YOUR_PHONEPE_CLIENT_SECRET"
PHONEPE_SALT_KEY="YOUR_PHONEPE_SALT_KEY"
PHONEPE_SALT_INDEX="1"
PHONEPE_ENVIRONMENT="UAT"
PHONEPE_WEBHOOK_SECRET="YOUR_PHONEPE_WEBHOOK_SECRET"

# Razorpay Gateway
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# IoT Broker & Hardware Settings
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
IOT_MODE=mock
OFFLINE_TIMEOUT_SECONDS=300
LOW_STOCK_THRESHOLD=20
