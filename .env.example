# =======================================================
# NAREE VENDTRACK - PRODUCTION & DEVELOPMENT CONFIGURATION
# =======================================================

# Server
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/naree_vending?schema=public"

# Authentication
JWT_SECRET="naree_super_secure_jwt_secret_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Payment Operational Mode ('mock' for local development without live keys, 'production' for live verification)
PAYMENT_PROVIDER_MODE=mock

# PhonePe Merchant Gateway
PHONEPE_MERCHANT_ID="MERCHANT_NAREE_001"
PHONEPE_CLIENT_ID="phonepe_client_id_placeholder"
PHONEPE_CLIENT_SECRET="phonepe_client_secret_placeholder"
PHONEPE_SALT_KEY="phonepe_salt_key_placeholder"
PHONEPE_SALT_INDEX="1"
PHONEPE_ENVIRONMENT="UAT"
PHONEPE_WEBHOOK_SECRET="phonepe_webhook_secret_placeholder"

# Razorpay Gateway
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_key_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# IoT Broker & Hardware Settings
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""
IOT_MODE=mock
OFFLINE_TIMEOUT_SECONDS=300
LOW_STOCK_THRESHOLD=20
